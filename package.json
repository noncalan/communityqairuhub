{
  "name": "qairu-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/patch-sonner-csp.mjs",
    "prebuild": "node scripts/patch-sonner-csp.mjs",
    "dev": "next dev",
    "build": "next build",
    "test:security": "node --experimental-strip-types --test src/lib/security/*.test.mts",
    "test:prototype": "node --experimental-strip-types --test src/lib/clubs/*.test.mts src/lib/telegram/*.test.mts",
    "test:core": "node --experimental-strip-types --test src/lib/core-api/*.test.mts",
    "test:onboarding": "node --experimental-strip-types --test src/lib/data/*.test.mts",
    "test": "npm run test:security && npm run test:prototype && npm run test:core && npm run test:onboarding",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "shadcn": "4.17.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
